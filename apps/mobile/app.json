{
  "expo": {
    "name": "RecetApp",
    "slug": "recetapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recetapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.recetapp.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B0462B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.recetapp.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B0462B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168
        }
      ],
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3a1b2ee-40fd-4f03-856d-3ca6643a8336"
      }
    },
    "owner": "yarce",
    "updates": {
      "url": "https://u.expo.dev/d3a1b2ee-40fd-4f03-856d-3ca6643a8336"
    }
  }
}
