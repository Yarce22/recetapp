{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "paths": {
      "@recetapp/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
