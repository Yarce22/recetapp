{
  "name": "recetapp",
  "version": "0.1.0",
  "private": true,
  "description": "Turn the ingredients you already have at home into a menu.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @recetapp/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "api": "npm run dev --workspace @recetapp/api"
  },
  "engines": {
    "node": ">=20"
  }
}